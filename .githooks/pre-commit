#!/bin/sh
# Formats staged Swift files with SwiftFormat (config: .swiftformat) and re-stages them.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for one commit:     git commit --no-verify

if ! command -v swiftformat >/dev/null 2>&1; then
    # Xcode-launched git doesn't inherit the shell PATH; Homebrew on Apple silicon lives here.
    PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
fi
if ! command -v swiftformat >/dev/null 2>&1; then
    echo "pre-commit: swiftformat not found (brew install swiftformat) - skipping formatting." >&2
    exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')
[ -z "$staged" ] && exit 0

status=0
echo "$staged" | while IFS= read -r file; do
    # A file with unstaged edits too can't be re-staged safely - that would sneak the
    # unstaged part into the commit. Lint it instead and let the author fix it.
    if ! git diff --quiet -- "$file"; then
        if ! swiftformat --lint --quiet "$file"; then
            echo "pre-commit: $file needs formatting but is partially staged." >&2
            echo "            Run 'swiftformat $file', review, and stage it again." >&2
            exit 1
        fi
        continue
    fi
    swiftformat --quiet "$file" && git add -- "$file"
done || status=1

exit $status
