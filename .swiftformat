# SwiftFormat config - applied to staged Swift files by .githooks/pre-commit.
# Kept in step with .swiftlint.yml (140-column lines, trailing commas allowed).

--swiftversion 6.0
--exclude .build,DerivedData,**/.swiftpm,*.xcodeproj

--indent 4
--maxwidth 140
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--commas always
--header strip
--stripunusedargs closure-only

# Match SwiftLint's modifier_order: `nonisolated final class`, not `final nonisolated class`.
--modifier-order nonisolated,final

# Keep short computed properties and functions on one line: `var id: String { code }`.
--disable wrapPropertyBodies,wrapFunctionBodies

# Declaration order in every type and extension: nested types, static properties, property
# wrappers, stored properties, computed properties, init, body, methods. Public before private
# within each group. No MARK comments.
--enable organizeDeclarations
--organizationmode type
--organizetypes class,actor,struct,enum,extension
--markcategories false

# Property attributes stay on the declaration's line: `@State private var draft = ""`.
--storedvarattrs same-line
--computedvarattrs same-line
